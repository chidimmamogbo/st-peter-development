# St. Peter's Result Portal - Frontend Environment Configuration Template
# Copy this file to .env.local and configure your backend endpoint:
# cp .env.example .env.local

# Base URL of the running FastAPI backend (do NOT include a trailing slash)
# - For local development: http://localhost:8000 (or http://127.0.0.1:8000)
# - For remote/staging: Replace with your team's designated backend host
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
